{
  "name": "@dsh-external/dsh-mood",
  "version": "0.1.0",
  "description": "A tiny behavioral mood ring for your AI coding agent: observes session behavior and shows a four-state mood status light in the session header",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "coding-agent",
    "mood",
    "status",
    "behavior",
    "observability",
    "mood-ring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raphaelutumn/dsh-mood.git"
  },
  "homepage": "https://github.com/Raphaelutumn/dsh-mood#readme",
  "bugs": {
    "url": "https://github.com/Raphaelutumn/dsh-mood/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-modules": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-modules": {
      "optional": true
    }
  }
}
